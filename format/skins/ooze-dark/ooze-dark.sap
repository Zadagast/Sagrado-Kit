# SagradoKit skin — Ooze Dark (original art; gel + dense pinstripes)
format = "sap"
version = 1

[meta]
name = "Ooze Dark"
creator = "SagradoKit"
description = "Dark graphite gel, dense pinstripes, and traffic lights"
version = "1.1"

[colors.primary]
background = "#1a1a1e"
dark = "#18181c"
disable_frame = "#242429"
disable_label = "#888890"
frame = "#18181c"
label = "#eeeef2"
light = "#5a5a64"

[colors.focus]
box = "#4a8ae8"

[colors.text]
background = "#1d1d22"
foreground = "#eeeef2"
hilite_background = "#4a8ae8"
hilite_foreground = "#eeeef2"
insertion_point = "#4a8ae8"

[colors.list]
background = "#1a1a1e"
label = "#eeeef2"
hilite_background = "#4a8ae8"
hilite_foreground = "#eeeef2"
sort_column_background = "#242428"
separator = "#18181c"

[colors.button]
light2 = "#5a5a64"
light1 = "#3c3c42"
face = "#2e2e34"
dark1 = "#18181c"
dark2 = "#121215"
frame = "#18181c"
label = "#eeeef2"

[colors.button_disable]
