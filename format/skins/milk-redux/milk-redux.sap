# SagradoKit skin — Milk Redux + donor WonderLight/icons
format = "sap"
version = 1

[meta]
name = "Milk Redux"
creator = "extracted from Hap"
description = "Art seed: buttons, icon button, popup, gel, tick/mutex, progress, scroll extras, pointed sliders, header, menu, WonderLight, icons"
version = "1.0"

[colors.button]
dark1 = "#222222"
dark2 = "#111111"
face = "#333333"
frame = "#000000"
label = "#ffffff"
light1 = "#444444"
light2 = "#666666"

[colors.button_disable]
dark1 = "#2e2e2e"
dark2 = "#2a2a2a"
face = "#333333"
frame = "#222222"
label = "#888888"
light1 = "#3a3a3a"
light2 = "#444444"

[colors.button_hilite]
dark1 = "#660000"
dark2 = "#440000"
face = "#880000"
frame = "#000000"
label = "#ffffff"
light1 = "#aa0000"
light2 = "#cc0000"

[colors.column_header]
dark = "#111111"
face = "#333333"
frame = "#000000"
hilite = "#333333"
hilite_dark = "#111111"
hilite_label = "#ffffff"
hilite_light = "#666666"
label = "#ffffff"
light = "#666666"

[colors.default_button]
dark = "#660000"
