dark1 = "#2053a0"
dark2 = "#1a4382"
frame = "#183e78"
label = "#ffffff"

[colors.default_button]
light = "#739cdb"
face = "#2868c8"
dark = "#1e4e96"
frame = "#183e78"

[colors.window]
light2 = "#ffffff"
light1 = "#f0f0f0"
face = "#f0f0f0"
dark1 = "#d0d0d0"
dark2 = "#9a9a9a"
frame = "#9a9a9a"
