# SagradoKit skin — Ooze (original art; gel + dense pinstripes)
format = "sap"
version = 1

[meta]
name = "Ooze"
creator = "SagradoKit"
description = "Aqua-inspired aluminum gel, dense pinstripes, and traffic lights"
version = "1.1"

[colors.primary]
background = "#f7f7f8"
dark = "#9a9a9a"
disable_frame = "#b8b8b8"
disable_label = "#999999"
frame = "#9a9a9a"
label = "#222222"
light = "#ffffff"

[colors.focus]
box = "#2868c8"

[colors.text]
background = "#f7f7f8"
foreground = "#222222"
hilite_background = "#2868c8"
hilite_foreground = "#ffffff"
insertion_point = "#2868c8"

[colors.list]
background = "#f7f7f8"
label = "#222222"
hilite_background = "#2868c8"
hilite_foreground = "#ffffff"
sort_column_background = "#eeeef0"
separator = "#9a9a9a"

[colors.button]
light2 = "#ffffff"
light1 = "#f0f0f0"
face = "#d0d0d0"
dark1 = "#9a9a9a"
dark2 = "#737373"
frame = "#9a9a9a"
label = "#222222"

[colors.button_disable]
light2 = "#e8e8e8"
light1 = "#dedede"
face = "#c8c8c8"
dark1 = "#b5b5b5"
dark2 = "#9a9a9a"
