{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Zadagast/Sagrado-Kit/format/schema.json",
  "title": "SagradoAppearance",
  "description": "SagradoKit .sap (Sagrado Appearance) format — named colour roles with reserved art/icon slots. Incomplete skins are valid; missing tokens fall through to stock.",
  "type": "object",
  "required": ["format", "version"],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "sap",
      "description": "Format identifier. Must be the string sap."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "description": "Skin format version."
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "creator": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string", "description": "Author-facing skin version string." }
      }
    },
    "colors": {
      "type": "object",
      "description": "Named colour role groups. Each leaf is #RRGGBB or #RRGGBBAA.",
      "additionalProperties": false,
      "properties": {
        "primary": { "$ref": "#/$defs/primaryGroup" },
        "important": { "$ref": "#/$defs/labelOnly" },
        "focus": { "$ref": "#/$defs/focusGroup" },
        "text": { "$ref": "#/$defs/textGroup" },
        "list": { "$ref": "#/$defs/listGroup" },
        "button": { "$ref": "#/$defs/buttonGroup" },
        "button_hilite": { "$ref": "#/$defs/buttonGroup" },
        "button_disable": { "$ref": "#/$defs/buttonGroup" },
        "default_button": { "$ref": "#/$defs/defaultButtonGroup" },
        "window": { "$ref": "#/$defs/windowGroup" },
        "window_focus": { "$ref": "#/$defs/windowGroup" },
        "menu": { "$ref": "#/$defs/menuGroup" },
        "slider": { "$ref": "#/$defs/sliderGroup" },
        "scrollbar": { "$ref": "#/$defs/scrollbarGroup" },
        "column_header": { "$ref": "#/$defs/columnHeaderGroup" },
        "file_label": { "$ref": "#/$defs/fileLabelGroup" },
        "progress": { "$ref": "#/$defs/progressGroup" },
        "workspace": { "$ref": "#/$defs/workspaceGroup" }
      }
    },
    "art": {
      "type": "object",
      "description": "Widget-chrome art slots named after AppearanceEdit Images entries (see docs/haxial-surface-map.md). Values are relative image paths for now; caps/positions metadata lands with art painting. Incomplete OK — missing slots fall through to colours.",
      "additionalProperties": { "type": "string" }
    },
    "icons": {
      "type": "object",
      "description": "Icon slots (16/32 marks). Separate from art. See docs/haxial-surface-map.md.",
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
    },
    "colorMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/color" }
    },
    "labelOnly": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "$ref": "#/$defs/color" }
      }
    },
    "primaryGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "light": { "$ref": "#/$defs/color" },
        "background": { "$ref": "#/$defs/color" },
        "dark": { "$ref": "#/$defs/color" },
        "frame": { "$ref": "#/$defs/color" },
        "label": { "$ref": "#/$defs/color" },
        "disable_frame": { "$ref": "#/$defs/color" },
        "disable_label": { "$ref": "#/$defs/color" }
      }
    },
    "focusGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "box": { "$ref": "#/$defs/color" }
      }
    },
    "textGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": { "$ref": "#/$defs/color" },
        "foreground": { "$ref": "#/$defs/color" },
        "hilite_background": { "$ref": "#/$defs/color" },
        "hilite_foreground": { "$ref": "#/$defs/color" },
        "insertion_point": { "$ref": "#/$defs/color" }
      }
    },
    "listGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": { "$ref": "#/$defs/color" },
        "label": { "$ref": "#/$defs/color" },
        "hilite_background": { "$ref": "#/$defs/color" },
        "hilite_foreground": { "$ref": "#/$defs/color" },
        "sort_column_background": { "$ref": "#/$defs/color" },
        "separator": { "$ref": "#/$defs/color" }
      }
    },
    "buttonGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "light2": { "$ref": "#/$defs/color" },
        "light1": { "$ref": "#/$defs/color" },
        "face": { "$ref": "#/$defs/color" },
        "dark1": { "$ref": "#/$defs/color" },
        "dark2": { "$ref": "#/$defs/color" },
        "frame": { "$ref": "#/$defs/color" },
        "label": { "$ref": "#/$defs/color" }
      }
    },
    "defaultButtonGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "light": { "$ref": "#/$defs/color" },
        "face": { "$ref": "#/$defs/color" },
        "dark": { "$ref": "#/$defs/color" },
        "frame": { "$ref": "#/$defs/color" }
      }
    },
    "windowGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "light2": { "$ref": "#/$defs/color" },
        "light1": { "$ref": "#/$defs/color" },
        "face": { "$ref": "#/$defs/color" },
        "dark1": { "$ref": "#/$defs/color" },
        "dark2": { "$ref": "#/$defs/color" },
        "frame": { "$ref": "#/$defs/color" },
        "label": { "$ref": "#/$defs/color" },
        "transition": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "items": { "$ref": "#/$defs/color" }
        }
      }
    },
    "menuGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "light": { "$ref": "#/$defs/color" },
        "background": { "$ref": "#/$defs/color" },
        "dark": { "$ref": "#/$defs/color" },
        "label": { "$ref": "#/$defs/color" },
        "hilite_light": { "$ref": "#/$defs/color" },
        "hilite_background": { "$ref": "#/$defs/color" },
        "hilite_dark": { "$ref": "#/$defs/color" },
        "hilite_label": { "$ref": "#/$defs/color" },
        "disable_label": { "$ref": "#/$defs/color" }
      }
    },
    "sliderGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bar": { "$ref": "#/$defs/color" },
        "bar_frame": { "$ref": "#/$defs/color" },
        "bar_hilite": { "$ref": "#/$defs/color" },
        "bar_hilite_frame": { "$ref": "#/$defs/color" },
        "indicator_light": { "$ref": "#/$defs/color" },
        "indicator": { "$ref": "#/$defs/color" },
        "indicator_dark": { "$ref": "#/$defs/color" },
        "indicator_frame": { "$ref": "#/$defs/color" },
        "indicator_hilite_light": { "$ref": "#/$defs/color" },
        "indicator_hilite": { "$ref": "#/$defs/color" },
        "indicator_hilite_dark": { "$ref": "#/$defs/color" },
        "indicator_hilite_frame": { "$ref": "#/$defs/color" },
        "disable_light": { "$ref": "#/$defs/color" },
        "disable": { "$ref": "#/$defs/color" },
        "disable_dark": { "$ref": "#/$defs/color" },
        "disable_frame": { "$ref": "#/$defs/color" }
      }
    },
    "scrollbarGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frame": { "$ref": "#/$defs/color" },
        "light": { "$ref": "#/$defs/color" },
        "face": { "$ref": "#/$defs/color" },
        "dark": { "$ref": "#/$defs/color" },
        "label": { "$ref": "#/$defs/color" },
        "hilite_light": { "$ref": "#/$defs/color" },
        "hilite": { "$ref": "#/$defs/color" },
        "hilite_dark": { "$ref": "#/$defs/color" },
        "hilite_label": { "$ref": "#/$defs/color" },
        "indicator_light": { "$ref": "#/$defs/color" },
        "indicator": { "$ref": "#/$defs/color" },
        "indicator_dark": { "$ref": "#/$defs/color" },
        "indicator_hilite_light": { "$ref": "#/$defs/color" },
        "indicator_hilite": { "$ref": "#/$defs/color" },
        "indicator_hilite_dark": { "$ref": "#/$defs/color" },
        "track_light2": { "$ref": "#/$defs/color" },
        "track_light1": { "$ref": "#/$defs/color" },
        "track": { "$ref": "#/$defs/color" },
        "track_dark1": { "$ref": "#/$defs/color" },
        "track_dark2": { "$ref": "#/$defs/color" },
        "disable_light": { "$ref": "#/$defs/color" },
        "disable": { "$ref": "#/$defs/color" },
        "disable_dark": { "$ref": "#/$defs/color" },
        "disable_frame": { "$ref": "#/$defs/color" },
        "disable_label": { "$ref": "#/$defs/color" }
      }
    },
    "columnHeaderGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frame": { "$ref": "#/$defs/color" },
        "light": { "$ref": "#/$defs/color" },
        "face": { "$ref": "#/$defs/color" },
        "dark": { "$ref": "#/$defs/color" },
        "label": { "$ref": "#/$defs/color" },
        "hilite_light": { "$ref": "#/$defs/color" },
        "hilite": { "$ref": "#/$defs/color" },
        "hilite_dark": { "$ref": "#/$defs/color" },
        "hilite_label": { "$ref": "#/$defs/color" }
      }
    },
    "fileLabelGroup": {
      "type": "object",
      "additionalProperties": false,
      "description": "File Label 0–15 list-item label tints (Hap colours 183–198).",
      "properties": {
        "0": { "$ref": "#/$defs/color" },
        "1": { "$ref": "#/$defs/color" },
        "2": { "$ref": "#/$defs/color" },
        "3": { "$ref": "#/$defs/color" },
        "4": { "$ref": "#/$defs/color" },
        "5": { "$ref": "#/$defs/color" },
        "6": { "$ref": "#/$defs/color" },
        "7": { "$ref": "#/$defs/color" },
        "8": { "$ref": "#/$defs/color" },
        "9": { "$ref": "#/$defs/color" },
        "10": { "$ref": "#/$defs/color" },
        "11": { "$ref": "#/$defs/color" },
        "12": { "$ref": "#/$defs/color" },
        "13": { "$ref": "#/$defs/color" },
        "14": { "$ref": "#/$defs/color" },
        "15": { "$ref": "#/$defs/color" }
      }
    },
    "progressGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bkgnd_light": { "$ref": "#/$defs/color" },
        "bkgnd": { "$ref": "#/$defs/color" },
        "bkgnd_dark": { "$ref": "#/$defs/color" },
        "frame": { "$ref": "#/$defs/color" },
        "label": { "$ref": "#/$defs/color" },
        "transition": {
          "type": "array",
          "items": { "$ref": "#/$defs/color" },
          "maxItems": 10
        }
      }
    },
    "workspaceGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background1": { "$ref": "#/$defs/color" },
        "background2": { "$ref": "#/$defs/color" },
        "background3": { "$ref": "#/$defs/color" },
        "background4": { "$ref": "#/$defs/color" }
      }
    }
  }
}
